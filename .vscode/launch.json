{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: debug client-side (with profile)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3200",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${env:LOCALAPPDATA}\\Google\\Chrome\\User Data",
            "runtimeArgs": [
                "--profile-directory=Default"
            ]
        },
        {
            "name": "Next.js: debug client-side (clean)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3200",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Next.js: debug server-side",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev"
        },
        {
            "name": "Next.js: debug full stack (with profile)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "- Local:.+(https?://.+)",
                "uriFormat": "%s",
                "action": "debugWithChrome",
                "webRoot": "${workspaceFolder}",
                "debugWithChrome": {
                    "userDataDir": "${env:LOCALAPPDATA}\\Google\\Chrome\\User Data",
                    "runtimeArgs": [
                        "--profile-directory=Default"
                    ]
                }
            }
        },
        {
            "name": "Next.js: debug full stack (clean)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "serverReadyAction": {
                "pattern": "- Local:.+(https?://.+)",
                "uriFormat": "%s",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "Next.js: attach",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}